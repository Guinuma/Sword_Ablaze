extends SceneTree
func _initialize() -> void:
	var tutorial = load("res://scripts/ui/combat_tutorial.gd").new()
	tutorial.shot()
	assert(tutorial.step == 0)
	tutorial.observe(0.6, Vector2.RIGHT, false)
	assert(tutorial.step == 1)
	tutorial.observe(0.1, Vector2.ZERO, true)
	assert(tutorial.step == 2)
	tutorial.shot()
	assert(tutorial.step == 3)
	tutorial.dashed()
	assert(tutorial.step == 4)
	tutorial.chose_upgrade()
	assert(tutorial.step == 5 and tutorial.hint().is_empty())
	tutorial.reset()
	assert(tutorial.step == 0 and tutorial.moved == 0.0)
	print("Tutorial checks complete: 0 failures")
	quit()
